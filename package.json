{
	"name": "snippy-mcp",
	"version": "0.2.2",
	"type": "module",
	"private": true,
	"description": "MCP server for pushing, storing, tagging, and rendering reusable code standards, snippets, and resources",
	"license": "MIT",
	"author": "David Mydlarz",
	"homepage": "https://github.com/c0ldfront/snippy-mcp",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/c0ldfront/snippy-mcp.git"
	},
	"bugs": {
		"url": "https://github.com/c0ldfront/snippy-mcp/issues"
	},
	"bin": {
		"snippy-mcp": "./src/cli.ts"
	},
	"scripts": {
		"dev": "bun --hot ./src/cli.ts",
		"start": "bun ./src/cli.ts",
		"test": "bun test",
		"typecheck": "tsc --noEmit",
		"lint": "biome check",
		"fix": "biome check --write",
		"check": "bun run lint && bun run typecheck && bun test",
		"bench": "bun run bench/all.bench.ts",
		"bench:baseline": "bun run bench/all.bench.ts --write-baseline"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.29.0",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.11",
		"@types/bun": "latest"
	},
	"peerDependencies": {
		"typescript": "^5.9.3"
	},
	"forge": {
		"entry": "./src/cli.ts",
		"binary": "snippy-mcp",
		"targets": "all",
		"outDir": "./target"
	}
}
