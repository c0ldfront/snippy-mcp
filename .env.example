# snippy-mcp environment example. Copy to .env and edit.
#
# Bun loads .env automatically; nothing here is required to run a local
# stdio dev session — every variable below has a sensible default.

# ── Storage ────────────────────────────────────────────────────────
# Path to the default workspace's SQLite file. Used as the implicit
# `default` workspace when SNIPPY_WORKSPACES is unset.
SNIPPY_DB=/home/you/.snippy-mcp.db

# Optional: declare named workspaces. JSON map of {name: dbPath}.
# A `default` workspace is always available even if you don't list it
# (backed by SNIPPY_DB).
# SNIPPY_WORKSPACES={"team":"/srv/snippy/team.db","personal":"/srv/snippy/personal.db"}

# Stdio transport workspace selection (overridable by --workspace=name).
# SNIPPY_WORKSPACE=default

# ── HTTP transport (only used when starting with --http) ───────────
# SNIPPY_HTTP_HOST=127.0.0.1
# SNIPPY_HTTP_PORT=7878

# Comma-separated allowlist of acceptable Origin header values.
# Unset = accept all (suitable only for localhost binds).
# SNIPPY_ORIGIN_ALLOWLIST=https://app.example,https://other.example

# Bearer-token gate. Comma-separated `token:role` pairs.
# Roles: reader | writer | admin. Tokens may contain colons (we split
# on the LAST colon). Unset = every connection is admin (loud warning).
# SNIPPY_HTTP_TOKENS=alice:admin,bob:writer,carol:reader

# ── Filesystem materialization ─────────────────────────────────────
# Colon-separated absolute paths the server is allowed to write into
# when a client doesn't advertise roots. Required for artifact.materialize
# unless the client declares `roots`.
# SNIPPY_ROOTS=/srv/repos/code:/srv/repos/configs

# ── Audit log ──────────────────────────────────────────────────────
# Retention in days; 0 disables pruning.
# SNIPPY_AUDIT_DAYS=90
